---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { gallery } from '../data/gallery';
import { person } from '../data/site';

// Every photo in src/assets/gallery, keyed by file name.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);
const byName = new Map(
  Object.entries(modules).map(([path, m]) => [path.split('/').pop()!, m.default]),
);

// Listed photos in gallery.ts order, then any unlisted ones at the end.
const listed = gallery.filter(([file]) => {
  if (!byName.has(file)) console.warn(`[gallery] ${file} is listed in gallery.ts but missing from src/assets/gallery`);
  return byName.has(file);
});
const listedNames = new Set(listed.map(([f]) => f));
const extras = [...byName.keys()].filter((f) => !listedNames.has(f)).sort().map((f) => [f, ''] as [string, string]);
const ordered = [...listed, ...extras];

const photos = await Promise.all(
  ordered.map(async ([file, alt], i) => {
    const src = byName.get(file)!;
    const thumb = await getImage({ src, width: 640, format: 'webp', quality: 78 });
    const full = await getImage({ src, width: Math.min(1800, src.width), format: 'webp', quality: 80 });
    return { i, alt, w: src.width, h: src.height, thumb: thumb.src, full: full.src };
  }),
);

// Masonry: place each photo, in order, into whichever column is shortest.
// Reading left-to-right, top-to-bottom follows the order in gallery.ts.
const COLS = 2;
const cols: (typeof photos)[] = Array.from({ length: COLS }, () => []);
const heights = new Array(COLS).fill(0);
for (const p of photos) {
  const c = heights.indexOf(Math.min(...heights));
  cols[c].push(p);
  heights[c] += p.h / p.w;
}

// Flush bottom: trim every tile in a column by the same small amount (a few %,
// via object-fit: cover) so both columns add up to the same height. The last
// tile in each column also flexes to soak up the leftover gap pixels.
const target = heights.reduce((a, b) => a + b, 0) / COLS;
const tiles = cols.map((col, c) => col.map((p) => ({ ...p, ratio: `${p.w} / ${((p.h * target) / heights[c]).toFixed(1)}` })));
import Links from '../components/Links.astro';
---
<Base title={`Gallery · ${person.name}`} description={`Food David has cooked and places he's been.`}>
  <header class="vhead"><div class="vtitle"><a class="name" href="/">{person.name}</a><h1 class="label">Gallery</h1></div><Links /></header>

  <div class="grid">
    {tiles.map((col) => (
      <div class="col">
        {col.map((p) => (
          <a class="ph" href={p.full} data-i={p.i} style={`aspect-ratio:${p.ratio}`}>
            <img src={p.thumb} alt={p.alt} width={p.w} height={p.h} loading={p.i < 6 ? 'eager' : 'lazy'} decoding="async" />
          </a>
        ))}
      </div>
    ))}
  </div>

  <dialog class="lb" id="lb" aria-label="Photo viewer">
    <img id="lb-img" alt="" />
    <button class="lb-btn lb-x" id="lb-x" type="button" aria-label="Close">×</button>
    <button class="lb-btn lb-prev" id="lb-prev" type="button" aria-label="Previous photo">‹</button>
    <button class="lb-btn lb-next" id="lb-next" type="button" aria-label="Next photo">›</button>
  </dialog>
</Base>

<style>
  .grid{display:flex;gap:8px;align-items:stretch;margin-top:var(--gap)}
  .col{flex:1;display:flex;flex-direction:column;gap:8px}
  .col .ph:last-child{flex-grow:1}
  .ph{display:block;overflow:hidden;border-radius:3px;background:var(--tile)}
  .ph img{display:block;width:100%;height:100%;object-fit:cover;transition:opacity .25s}
  .ph{transition:box-shadow .2s}
  .ph:hover{box-shadow:0 0 0 2px var(--accent)}
  .ph:hover img{opacity:.92}
  .ph:focus-visible{outline:2px solid var(--fg);outline-offset:2px}

  .lb{border:0;padding:0;margin:0;width:100vw;height:100dvh;max-width:none;max-height:none;background:color-mix(in srgb,var(--bg) 97%,transparent);color:var(--fg)}
  .lb::backdrop{background:transparent}
  .lb[open]{display:flex;align-items:center;justify-content:center;animation:lbIn .2s ease-out}
  @keyframes lbIn{from{opacity:0}to{opacity:1}}
  .lb img{max-width:min(92vw,1200px);max-height:86dvh;width:auto;height:auto;border-radius:3px;user-select:none}
  .lb-btn{position:absolute;background:none;border:0;color:var(--fg);font:300 2rem/1 var(--font-sans);width:48px;height:48px;cursor:pointer;opacity:.7;transition:opacity .2s}
  .lb-btn:hover{opacity:1}
  .lb-x{top:12px;right:12px}
  .lb-prev{left:8px;top:50%;transform:translateY(-50%)}
  .lb-next{right:8px;top:50%;transform:translateY(-50%)}
  @media (max-width:600px){.lb-prev,.lb-next{top:auto;bottom:16px;transform:none}}
  @media (prefers-reduced-motion:reduce){.lb[open]{animation:none}.ph,.ph img{transition:none}}
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.ph')].sort(
    (a, b) => Number(a.dataset.i) - Number(b.dataset.i),
  );
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  let cur = 0;

  const show = (i: number) => {
    cur = (i + links.length) % links.length;
    const a = links[cur];
    img.src = a.href;
    img.alt = a.querySelector('img')?.alt ?? '';
    // Warm the neighbours so arrowing feels instant.
    [cur - 1, cur + 1].forEach((j) => { new Image().src = links[(j + links.length) % links.length].href; });
  };

  links.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    show(Number(a.dataset.i));
    lb.showModal();
  }));
  document.getElementById('lb-x')!.addEventListener('click', () => lb.close());
  document.getElementById('lb-prev')!.addEventListener('click', () => show(cur - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => show(cur + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('close', () => links[cur].focus());
  document.addEventListener('keydown', (e) => {
    if (!lb.open) return;
    if (e.key === 'ArrowLeft') show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
  });

  // Swipe on phones.
  let x0: number | null = null;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>
