---
import Base from '../layouts/Base.astro';
import SceneBanner from '../components/SceneBanner.astro';
import { audiences, hiringSchedule, jobs } from '../data/site';

const home = audiences[0];
import Links from '../components/Links.astro';
---
<Base>
  <SceneBanner />

  <div class="titlebar">
    <h1>Hi, I'm David.</h1>
    <Links />
  </div>

  <p class="lead">I build software for <button class="rot" id="rot" type="button" aria-label={`${home}. Click to see examples.`}><span class="rot-word" id="rot-word">{home}</span><span class="caret" id="caret" aria-hidden="true"></span></button>.</p>

  <p>I work on AI systems and backend infrastructure, turning complex real-world workflows into products that hold up at scale and stay simple to use. I study Management Engineering and Computing at the University of Waterloo.</p>

  <p>I'm currently at <a class="dotted" href="https://www.8090.ai/" target="_blank" rel="noopener">8090</a>, building software for surgical sales reps at a multi-billion-dollar eye health company. Before that, I designed and shipped Plan Mode at <a class="dotted" href="https://www.cognichip.ai/" target="_blank" rel="noopener">Cognichip</a>, an agentic AI IDE for chip design backed by <a class="dotted" href="https://www.cognichip.ai/news/seligman-ventures-leads-cognichips-60m-series-a-to-back-physics-informed-ai-for-chip-design-intel-ceo-lip-bu-tan-and-seligman-ventures-umesh-padval-join-the-board" target="_blank" rel="noopener">Intel's CEO</a>, and spent two terms at <a class="dotted" href="https://www.loblawdigital.co/" target="_blank" rel="noopener">Loblaws</a>, Canada's largest retailer, building LLM pipelines across 150,000+ grocery items.</p>

  <p>During school, I was Technical Project Lead at <a class="dotted" href="https://uwblueprint.org/" target="_blank" rel="noopener">UW Blueprint</a>, where I mentored developers and drove the architectural design of a route management system for Food4Kids Waterloo Region, now scaling to three chapters across <a class="dotted" href="https://www.food4kids.ca/" target="_blank" rel="noopener">Food4Kids Ontario</a> and serving over 5,000 people at 154 schools.</p>

  <p>I grew up in Shanghai and Calgary. Outside of work I love to cook, read, and travel.</p>

  <details class="xp">
    <summary>
      <span class="xp-l"><h2>Experience</h2><svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="hire" id="hire">{hiringSchedule[0][2]}</span>
    </summary>
    <ul class="exp">
      {jobs.map((j) => (
        <li>
          <div class="row">
            <span class="co"><a class="dotted" href={j.url} target="_blank" rel="noopener">{j.co}</a> · {j.role}</span>
            <span class="when">{j.when}</span>
          </div>
          <p>{j.d}</p>
        </li>
      ))}
    </ul>
  </details>
</Base>

<script is:inline define:vars={{ SCHEDULE: hiringSchedule, words: audiences }}>
  // Internship line: picked in the browser so it follows the calendar without a rebuild.
  {
    const now = new Date();
    let msg = SCHEDULE[0][2];
    for (const [y, m, text] of SCHEDULE) if (now >= new Date(y, m - 1, 1)) msg = text;
    const hire = document.getElementById('hire');
    if (msg === null) hire.remove(); else hire.textContent = msg;
  }

  // Audience word: "domain experts" is home. One pass through the examples on load,
  // then each click retypes the next one, and 12 s without a click retypes back home.
  {
    const HOME = words[0];
    const btn = document.getElementById('rot'), word = document.getElementById('rot-word'), caret = document.getElementById('caret');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    let i = 0, run = 0, idle = null;
    const retype = async (next) => {
      const id = ++run;
      btn.setAttribute('aria-label', next + (next === HOME ? '. Click to see examples.' : '. Click to see another example.'));
      if (reduce) { word.textContent = next; return; }
      caret.classList.add('on');
      let t = word.textContent;
      while (t.length) { if (id !== run) return; t = t.slice(0, -1); word.textContent = t; await sleep(30); }
      await sleep(120);
      // Typing eases out: ~40ms per letter at the start, slowing to ~110ms on the last one.
      const n = next.length;
      for (let k = 0; k < n; k++) {
        const p = n > 1 ? k / (n - 1) : 1;
        await sleep(40 + 70 * p * p);
        if (id !== run) return;
        t += next[k]; word.textContent = t;
      }
      await sleep(500);
      if (id === run) caret.classList.remove('on');
    };
    const goHome = () => { clearTimeout(idle); if (i !== 0) { i = 0; retype(HOME); } };
    const armIdle = () => { clearTimeout(idle); idle = setTimeout(goHome, 12000); };
    let auto = !reduce;
    (async () => {
      // Wait for the arrival intro (wipe, then underlines) to finish before the word starts changing.
      await sleep(document.documentElement.classList.contains('arrived') ? 1800 : 3600);
      for (let k = 1; k <= words.length && auto; k++) {
        i = k % words.length;
        await retype(words[i]);
        if (!auto) return;
        await sleep(1700);
      }
      auto = false;
    })();
    btn.addEventListener('click', () => {
      auto = false;
      i = (i + 1) % words.length;
      retype(words[i]);
      if (i === 0) clearTimeout(idle); else armIdle();
    });
  }
</script>
